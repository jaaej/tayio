# Copy to .env.local for local work; set the same keys as Vercel Production
# environment variables at deploy time. Never commit real values.
#
# Deploy note: NEXT_PUBLIC_SUPABASE_URL is read at BUILD time by next.config.ts
# to build the Content-Security-Policy connect-src. Set the environment
# variables in Vercel BEFORE the first production build, or the build bakes a
# CSP that blocks every Supabase request and you have to redeploy.

# Supabase project - Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely - never expose to the client.
# Rotation procedure: docs/runbooks.md section I4.
SUPABASE_SERVICE_ROLE_KEY=

# Runtime queries - transaction pooler (port 6543, high connection limit)
DATABASE_URL=

# Migrations / DDL - session pooler (port 5432). Required by db:bootstrap,
# apply-migration and check-rls; drizzle-kit prefers it over DATABASE_URL.
DIRECT_URL=

# Optional. HMAC key for the admin PIN unlock cookie (src/lib/admin-lock.ts).
# Falls back to SUPABASE_SERVICE_ROLE_KEY when unset, which works but means
# rotating the service-role key silently invalidates every active PIN unlock.
# Set it to any long random string to decouple the two.
ADMIN_PIN_SECRET=
